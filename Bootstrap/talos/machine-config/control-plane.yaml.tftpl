apiVersion: v1alpha1
kind: KubeNodeConfig
labels:
  node-role.kubernetes.io/control-plane: ""
%{ for key, value in node.labels ~}
  ${jsonencode(key)}: ${jsonencode(value)}
%{ endfor ~}
---
# Cilium ersetzt Flannel und kube-proxy. Ohne KubeProxyConfig-Dokument wäre kube-proxy
# standardmäßig an, ein Löschen reicht also nicht.
apiVersion: v1alpha1
kind: KubeProxyConfig
enabled: false
---
apiVersion: v1alpha1
kind: KubeFlannelCNIConfig
$patch: delete
---
# Gateway-API-CRDs für Cilium: Talos lädt sie beim Bootstrap, bevor Cilium startet.
apiVersion: v1alpha1
kind: KubeExternalManifestConfig
name: gateway-api
url: ${gateway_api_url}
---
# kube-apiserver akzeptiert ID-Tokens von Dex (ArgoCD/Infrastructure/dex), z.B. für Headlamp.
# Benutzer = E-Mail, Gruppen aus dem Claim "groups", beide mit Präfix "oidc:".
# Ist Dex nicht erreichbar, startet der API-Server trotzdem; nur OIDC-Logins schlagen fehl.
# Neue Clients, die direkt gegen den API-Server gehen, unter audiences ergänzen.
apiVersion: v1alpha1
kind: KubeAuthenticationConfig
configuration:
  apiVersion: apiserver.config.k8s.io/v1
  kind: AuthenticationConfiguration
  jwt:
    - issuer:
        url: https://dex.k8s.cakiroglu.me
        audiences:
          - headlamp
      claimMappings:
        username:
          claim: email
          prefix: "oidc:"
        groups:
          claim: groups
          prefix: "oidc:"
